# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.

APP_NAME=FrameMind AI
ENVIRONMENT=development

# Frontend URL allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Where videos, frames and the SQLite database are stored.
# Relative paths are resolved from the project root.
STORAGE_DIR=storage

# Not used yet - reserved for the AI analysis milestone (06).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional tuning (defaults shown)
# MAX_UPLOAD_BYTES=1073741824
# FFPROBE_TIMEOUT_SECONDS=30
# FFMPEG_TIMEOUT_SECONDS=120
# MAX_CONCURRENT_EXTRACTIONS=2
# CLIP_SAMPLE_FPS=8
# CLIP_MAX_FRAMES=40
# FRAME_MAX_WIDTH=1280
