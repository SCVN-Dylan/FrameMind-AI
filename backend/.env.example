# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.

APP_NAME=FrameMind AI
ENVIRONMENT=development

# Frontend URL allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Where videos, frames and the SQLite database are stored.
# Relative paths are resolved from the project root.
STORAGE_DIR=storage

# AI analysis runs through the local Codex CLI signed in with your ChatGPT account
# (run `codex login` once in a terminal). No API key is needed or used.
AI_PROVIDER=codex_cli
CODEX_CLI_PATH=codex
# CODEX_MODEL=            # empty = Codex CLI default model
CODEX_TIMEOUT_SECONDS=180
CODEX_MAX_CONCURRENT_JOBS=1
AI_MAX_FRAMES_PER_CLIP=6
# AI_MAX_PAIRS_PER_JOB=5
# CODEX_ALLOW_API_KEY_AUTH=false   # keep false: never bill an API key by accident

# Not used by the Codex CLI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional tuning (defaults shown)
# MAX_UPLOAD_BYTES=1073741824
# FFPROBE_TIMEOUT_SECONDS=30
# FFMPEG_TIMEOUT_SECONDS=120
# MAX_CONCURRENT_EXTRACTIONS=2
# CLIP_SAMPLE_FPS=8
# CLIP_MAX_FRAMES=40
# FRAME_MAX_WIDTH=1280
