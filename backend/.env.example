# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git.

APP_NAME=FrameMind AI
ENVIRONMENT=development

# Frontend URL allowed to call this API (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Where videos, frames and the SQLite database are stored.
# Relative paths are resolved from the project root.
STORAGE_DIR=storage

# Not used yet - reserved for the AI analysis milestone.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
